{% extends 'client_cabinet/base.html' %}

{% block title %}Прогресс обучения — MUSERP{% endblock %}

{% block content %}
<!-- Заголовок -->
<div class="page-header">
    <h1 class="page-title">📊 Прогресс обучения</h1>
    <p class="page-subtitle">Статистика посещаемости и успеваемости</p>
</div>

<!-- Статистика -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-value green">{{ lessons_completed }}</div>
        <div class="stat-label">✅ Проведено</div>
    </div>
    <div class="stat-card">
        <div class="stat-value yellow">{{ lessons_scheduled }}</div>
        <div class="stat-label">⏳ Запланировано</div>
    </div>
    <div class="stat-card">
        <div class="stat-value red">{{ lessons_cancelled }}</div>
        <div class="stat-label">❌ Отменено</div>
    </div>
    <div class="stat-card">
        <div class="stat-value blue">{{ lessons_total }}</div>
        <div class="stat-label">📊 Всего</div>
    </div>
</div>

<!-- Абонементы -->
<div class="card">
    <h2 class="card-title">🎫 Активные абонементы</h2>
    
    {% if enrollments %}
        {% for item in enrollments %}
            {% with enrollment=item.enrollment progress_percent=item.progress_percent %}
            <div style="padding: 20px; background: var(--gray-50); border-radius: var(--radius); margin-bottom: 20px;">
                <h3 style="margin-bottom: 16px;">{{ enrollment.product.name }}</h3>
                
                {% if enrollment.lessons_total %}
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span>Занятия: {{ enrollment.lessons_used }} из {{ enrollment.lessons_total }}</span>
                        <span><strong>{{ progress_percent }}%</strong></span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: {{ progress_percent }}%"></div>
                    </div>
                {% endif %}
                
                {% if enrollment.total_practice %}
                    <div style="margin-top: 16px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span>Практики: {{ enrollment.practices_used }} из {{ enrollment.total_practice }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
            {% endwith %}
        {% endfor %}
    {% else %}
        <p style="color: var(--gray-600); text-align: center; padding: 40px;">
            У вас нет активных абонементов.
        </p>
    {% endif %}
</div>

<!-- Последние занятия -->
<div class="card">
    <h2 class="card-title">📋 Последние занятия</h2>
    
    {% if recent_lessons %}
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Время</th>
                        <th>Преподаватель</th>
                        <th>Кабинет</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    {% for lesson in recent_lessons %}
                    <tr>
                        <td>{{ lesson.start_time|date:"d.m.Y" }}</td>
                        <td>{{ lesson.start_time|time:"H:i" }} - {{ lesson.end_time|time:"H:i" }}</td>
                        <td>{{ lesson.teacher }}</td>
                        <td>{{ lesson.room.name }}</td>
                        <td>
                            {% if lesson.status == 'completed' %}
                                <span class="status-badge success">✅ Проведено</span>
                            {% elif lesson.status == 'scheduled' %}
                                <span class="status-badge warning">⏳ Запланировано</span>
                            {% elif lesson.status == 'cancelled' %}
                                <span class="status-badge danger">❌ Отменено</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p style="color: var(--gray-600); text-align: center; padding: 40px;">
            У вас пока нет занятий.
        </p>
    {% endif %}
</div>
{% endblock %}
