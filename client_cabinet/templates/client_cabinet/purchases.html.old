{% extends 'client_cabinet/base.html' %}

{% block title %}Мои покупки — MUSERP{% endblock %}

{% block content %}
<!-- Заголовок -->
<div class="page-header">
    <h1 class="page-title">🛒 Мои покупки</h1>
    <p class="page-subtitle">Абонементы и занятия</p>
</div>

{% if enrollments %}
    {% for item in enrollments %}
    {% with enrollment=item.enrollment progress_percent=item.progress_percent %}
    <div class="card">
        <h2 class="card-title">{{ enrollment.product.name }}</h2>
        
        <div style="display: grid; gap: 16px; margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Статус:</strong></span>
                {% if enrollment.status == 'active' %}
                    <span class="status-badge success">✅ Активен</span>
                {% elif enrollment.status == 'completed' %}
                    <span class="status-badge warning">⏳ Завершён</span>
                {% else %}
                    <span class="status-badge danger">❌ Неактивен</span>
                {% endif %}
            </div>
            
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Занятий использовано:</strong></span>
                <span>{{ enrollment.lessons_used }} из {{ enrollment.lessons_total|default:"—" }}</span>
            </div>
            
            {% if enrollment.lessons_total and enrollment.lessons_total > 0 %}
            <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span>Прогресс занятий</span>
                    <span><strong>{{ progress_percent }}%</strong></span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: {{ progress_percent }}%"></div>
                </div>
            </div>
            {% endif %}
            
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Дата начала:</strong></span>
                <span>{{ enrollment.created_at|date:"d.m.Y" }}</span>
            </div>
            
            {% if enrollment.total_practice %}
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Практик использовано:</strong></span>
                <span>{{ enrollment.practices_used }} из {{ enrollment.total_practice }}</span>
            </div>
            {% endif %}
        </div>
    </div>
    {% endwith %}
    {% endfor %}
{% else %}
    <div class="card">
        <p style="color: var(--gray-600); text-align: center; padding: 40px;">
            У вас пока нет покупок.
        </p>
    </div>
{% endif %}
{% endblock %}