{% extends 'client_cabinet/base.html' %}

{% block title %}Баланс и оплаты — MUSERP{% endblock %}

{% block content %}
<!-- Заголовок -->
<div class="page-header">
    <h1 class="page-title">💰 Баланс и оплаты</h1>
    <p class="page-subtitle">История платежей и задолженность</p>
</div>

<!-- Сводка -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-value green">{{ total_paid|floatformat:0 }} ₽</div>
        <div class="stat-label">💰 Всего оплачено</div>
    </div>
    <div class="stat-card">
        <div class="stat-value yellow">{{ total_due|floatformat:0 }} ₽</div>
        <div class="stat-label">⏳ К оплате</div>
    </div>
    <div class="stat-card">
        <div class="stat-value blue">{{ total_amount|floatformat:0 }} ₽</div>
        <div class="stat-label">📊 Общая сумма</div>
    </div>
</div>

<!-- Ближайший платёж -->
{% if next_payment %}
<div class="card" style="border-left: 4px solid var(--warning-color);">
    <h2 class="card-title">⚠️ Ближайший платёж</h2>
    <div style="display: grid; gap: 8px;">
        <div><strong>№{{ next_payment.installment_number }}</strong> — {{ next_payment.amount_paid_by_client|floatformat:0 }} ₽</div>
        <div><strong>Срок:</strong> {{ next_payment.due_date|date:"d.m.Y" }}</div>
        <div><strong>Продукт:</strong> {{ next_payment.enrollment.product.name|default:"—" }}</div>
    </div>
</div>
{% endif %}

<!-- История платежей -->
<div class="card">
    <h2 class="card-title">📋 История платежей</h2>
    
    {% if payments %}
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Продукт</th>
                        <th>Сумма</th>
                        <th>Срок</th>
                        <th>Статус</th>
                        <th>Оплачено</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in payments %}
                    <tr>
                        <td>{{ payment.installment_number }}</td>
                        <td>{{ payment.enrollment.product.name|default:"—" }}</td>
                        <td>{{ payment.amount_paid_by_client|floatformat:0 }} ₽</td>
                        <td>{{ payment.due_date|date:"d.m.Y" }}</td>
                        <td>
                            {% if payment.is_paid %}
                                <span class="status-badge success">✅ Оплачен</span>
                            {% else %}
                                <span class="status-badge danger">❌ Не оплачен</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if payment.paid_at %}
                                {{ payment.paid_at|date:"d.m.Y H:i" }}
                            {% else %}
                                <span style="color: var(--gray-300);">—</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p style="color: var(--gray-600); text-align: center; padding: 40px;">
            У вас пока нет платежей.
        </p>
    {% endif %}
</div>
{% endblock %}
