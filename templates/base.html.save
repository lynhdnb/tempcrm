<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}ERP — Школа диджеинга{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f8f9fa;
    }
    .sidebar {
      width: 60px;
      background: white;
      border-right: 1px solid #e9ecef;
      height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
    }
    .main-content {
      margin-left: 60px;
      padding: 20px;
    }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }
    .menu-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px 0;
      color: #495057;
      text-decoration: none;
      font-size: 22px;
    }
    .menu-item:hover, .menu-item.active {
      background: #e9ecef;
      color: #0d6efd;
    }
    .user-info {
      font-size: 14px;
      color: #6c757d;
    }
    .logout-link {
      font-size: 13px;
      color: #6c757d;
      text-decoration: none;
      margin-left: 12px;
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar">
    <a href="/" class="menu-item">📊</a>
    {% if user.profile.role in 'owner,admin,manager' %}
      <a href="/clients/" class="menu-item">👤</a>
      <a href="/lessons/" class="menu-item">📅</a>
    {% endif %}
    <a href="/lessons/calendar/" class="menu-item">🗓️</a>
  </div>

  <!-- Main content -->
  <div class="main-content">
    <div class="top-bar">
      <h1>{% block page_title %}{% endblock %}</h1>
      <div class="user-info">
        {{ user.first_name }} {{ user.last_name }}
<form method="post" action="{% url 'logout' %}" style="display: inline;">
  {% csrf_token %}
  <button type="submit" class="logout-link" style="
    background: none;
    border: none;
    color: #6c757d;
    font-size: 13px;
    text-decoration: none;
    margin-left: 12px;
    cursor: pointer;
  	  ">Выйти</button>
	</form>
      </div>
    </div>

    {% block content %}
    {% endblock %}
  </div>

</body>
</html>
